PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8080

# Deflock camera data (tile based catalog on CDN)
DEFLOCK_TILES_BASE_URL=https://cdn.deflock.me/regions
DEFLOCK_TILE_SIZE_DEGREES=20
DEFLOCK_CACHE_TTL_SECONDS=300
DEFLOCK_MAX_TILES=24

# Local storage
DB_PATH=./data/flockcam.db
SERVER_BASE_URL=http://localhost:8080
DEVICE_ID=anonymous-device

# Sessions and verification codes
SESSION_TTL_SECONDS=2592000
CODE_TTL_SECONDS=600
CODE_MAX_ATTEMPTS=5
# Local development only: return verification/recovery codes in API responses.
DEV_RETURN_CODES=false

# Entitlements
FREE_MAX_RADIUS_METERS=2000
FREE_VISIBLE_CAMERAS=25
FREE_REGION_MAX_CAMERAS=250
PREMIUM_MAX_RADIUS_METERS=50000
PREMIUM_REGION_MAX_CAMERAS=5000
AD_REWARD_COOLDOWN_SECONDS=900
AD_REWARD_SECONDS=1800

# Load shedding: premium requests get their own concurrency budget and free
# requests yield while premium work is active.
PREMIUM_CONCURRENCY=8
FREE_CONCURRENCY=3

# Google sign-in / Play Billing
GOOGLE_CLIENT_ID=
PLAY_PACKAGE_NAME=com.techted89.flockcam
PLAY_STORE_SERVICE_ACCOUNT_JSON=
PLAY_STORE_SERVICE_ACCOUNT_FILE=
# Local testing only. Never enable in production.
ALLOW_UNVERIFIED_PURCHASES=false

# PayPal REST (sandbox by default)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
APP_RETURN_URL=flockcam://payment/complete

# Email / SMS delivery webhooks. Without them, codes are logged in development.
MAIL_WEBHOOK_URL=
MAIL_FROM=no-reply@flockcam.app
SMS_WEBHOOK_URL=

# Google account used by Playwright for Play Console / Cloud Console automation.
# Copy this file to .env and fill in the real values locally. Never commit .env.
SERVICE_EMAIL=theodoredrach@gmail.com
SERVICE_PASS=

# Filled in after the Google Cloud / Play Console setup.
GOOGLE_CLOUD_PROJECT=
