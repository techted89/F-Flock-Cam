# Production environment for the F-Flock-Cam server.
# Copy to /etc/flockcam/flockcam.env, chmod 600, chown root:flockcam.
# Every value here is read at startup; restart the service after editing.

NODE_ENV=production
PORT=8080
# Keep the Node process on loopback and let nginx terminate TLS.
HOST=127.0.0.1
TRUST_PROXY=1
PUBLIC_BASE_URL=https://api.flockcam.app
APP_RETURN_URL=flockcam://payment/complete

# SQLite lives on the persistent volume, never inside the release directory.
DB_PATH=/var/lib/flockcam/flockcam.db

# Deflock tile catalog. Tiles are cached in SQLite and in memory; 24 tiles is
# ~20 degrees each, which is enough for a 50 km premium region.
DEFLOCK_TILES_BASE_URL=https://cdn.deflock.me/regions
DEFLOCK_TILE_SIZE_DEGREES=20
DEFLOCK_CACHE_TTL_SECONDS=300
DEFLOCK_MAX_TILES=24

# Sessions, codes, and entitlement limits.
SESSION_TTL_SECONDS=2592000
CODE_TTL_SECONDS=600
CODE_MAX_ATTEMPTS=5
DEV_RETURN_CODES=false
FREE_MAX_RADIUS_METERS=2000
FREE_VISIBLE_CAMERAS=25
FREE_REGION_MAX_CAMERAS=250
PREMIUM_MAX_RADIUS_METERS=50000
PREMIUM_REGION_MAX_CAMERAS=5000
AD_REWARD_COOLDOWN_SECONDS=900
AD_REWARD_SECONDS=1800

# Load shedding for a 4-core box. Premium keeps a reserved budget; free work
# yields while premium requests are in flight.
PREMIUM_CONCURRENCY=8
FREE_CONCURRENCY=3

# Google sign-in + Play Billing verification.
GOOGLE_CLIENT_ID=
PLAY_PACKAGE_NAME=com.techted89.flockcam
PLAY_STORE_SERVICE_ACCOUNT_FILE=/etc/flockcam/play-service-account.json
ALLOW_UNVERIFIED_PURCHASES=false

# PayPal REST (use https://api-m.paypal.com in production).
PAYPAL_BASE_URL=https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Verification/recovery delivery. Without a webhook the server logs codes and
# never emails them, so production must set at least MAIL_WEBHOOK_URL.
MAIL_WEBHOOK_URL=
MAIL_FROM=no-reply@flockcam.app
SMS_WEBHOOK_URL=
